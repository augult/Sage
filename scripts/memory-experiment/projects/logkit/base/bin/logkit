#!/bin/sh
# logkit: small log helpers. Usage: logkit COMMAND [ARGS] < logfile
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
die() { echo "logkit: $*" >&2; exit 2; }
. "$ROOT/build/logkit.sh"

cmd=${1:-}
[ $# -gt 0 ] && shift
case "$cmd" in
  '' | -h | --help) echo "usage: logkit COMMAND [ARGS] < logfile   (commands: filter, since, fmt, stats)"; exit 0 ;;
esac
type "cmd_$cmd" >/dev/null 2>&1 || die "unknown command: $cmd"
"cmd_$cmd" "$@"
