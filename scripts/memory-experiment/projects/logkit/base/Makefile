LIBS := $(sort $(wildcard lib/*.sh))

gen: build/logkit.sh

build/logkit.sh: $(LIBS) data/levels.txt tools/gen-levels.sh
	@mkdir -p build
	@{ echo '# GENERATED by make gen from lib/*.sh and data/levels.txt. Do not edit.'; \
	   sh tools/gen-levels.sh data/levels.txt; cat $(LIBS); } > $@
	@echo "generated $@"

clean:
	rm -rf build

.PHONY: gen clean
